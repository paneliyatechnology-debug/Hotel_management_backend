PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hotel_management
JWT_SECRET=your_jwt_secret_key_here

# 🚀 Resend Email API (Port 443 - Recommended for Cloud Deployments like Render & Railway)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=Grand Royale <onboarding@resend.dev>

# 📧 SMTP Configuration (Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_NAME=The Grand Royale Hotel
FROM_EMAIL=your_email@gmail.com

# 📮 Postman Live Auto-Sync
POSTMAN_API_KEY=your_postman_api_key
POSTMAN_COLLECTION_UID=your_postman_collection_uid
