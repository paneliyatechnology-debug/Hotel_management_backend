PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/hotel_management
JWT_SECRET=your_jwt_secret_key_here

# 🚀 Email Configuration
# Mode 1: Brevo Email API (Port 443 - HTTPS REST Fallback)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_email@gmail.com
FROM_NAME=The Grand Royale Hotel
FROM_EMAIL=your_email@gmail.com

# Mode 2: SMTP Configuration (Nodemailer connection pooling)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# ⚡ Redis & BullMQ Background Queue Configuration
# If Redis is running, BullMQ is used. If Redis is offline, system automatically uses the Resilient In-Memory Async Queue.
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
RUN_EMAIL_WORKER_INLINE=true

# 📮 Postman Live Auto-Sync
POSTMAN_API_KEY=your_postman_api_key
POSTMAN_COLLECTION_UID=your_postman_collection_uid
